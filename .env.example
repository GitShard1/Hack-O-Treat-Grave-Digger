# Copy to .env.local and fill in. Never commit real keys.
# Everything is optional: with nothing set, public repos still work (fallback monsters, 60 GitHub calls/hour).

# --- Claude (live monster writing) ---
ANTHROPIC_API_KEY=

# --- GitHub server token (raises the public rate limit to 5,000/hour) ---
# Optional. Fine-grained token, public repositories, read-only, no extra permissions needed.
# If set, it is checked at startup and the app will not start if GitHub rejects it.
GITHUB_TOKEN=

# --- GitHub sign-in for private repos (GitHub App; see README "GitHub sign-in") ---
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# The app's URL name, from https://github.com/apps/<slug>
GITHUB_APP_SLUG=
# At least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
# Where this site runs, no trailing slash (http://localhost:3000 locally, your real URL when deployed)
APP_URL=http://localhost:3000
